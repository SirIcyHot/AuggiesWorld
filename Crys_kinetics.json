import numpy as np

# ── 1. SOLUBILITY COEFFICIENTS ─────────────────────────────────────────────
# S(T) = A + B*T + C*T^2 + D*T^3   [kg/m^3],  T in [K]
# For RDX in the acetic acid/acetic anhydride solvent mixture.
# Literature (Haller et al.): rough values for RDX solubility in AcOH/Ac2O.
# Replace with your experimentally measured solubility curve.
solub_cts = np.array([
    -52.0,    # A  [kg/m^3]
     0.30,    # B  [kg/m^3/K]
     0.0,     # C  [kg/m^3/K^2]
     0.0      # D  [kg/m^3/K^3]
])

# ── 2. PRIMARY NUCLEATION  [3 elements: A, B, C] ───────────────────────────
# f = A * exp(-B / (R*T)) * σ|σ|^(C-1)
# Result units: number of particles / s / m^3 slurry
# σ = relative supersaturation = (c - c*) / c*
#   A : pre-exponential factor  [#/s/m^3]
#   B : activation energy       [J/mol]
#   C : supersaturation order   [-]
prim_params = np.array([
    1.0e10,   # A  — tune to your nucleation onset data
    6.0e4,    # B  — ~60 kJ/mol is a typical activation energy
    2.0       # C  — order; start at 2 and fit
])

# ── 3. SECONDARY NUCLEATION  [4 elements: A, B, C, D] ─────────────────────
# f = A * exp(-B / (R*T)) * σ|σ|^(C-1) * (kv * μ3)^D
# Result units: number of particles / s / m^3 slurry
# μ3 is the 3rd moment of the CSD (proportional to slurry solid volume)
# kv : volumetric shape factor (= π/6 for spheres)
#   D : moment order (how strongly seed crystal mass drives secondary nucl.)
sec_params = np.array([
    1.0e8,    # A
    5.0e4,    # B  [J/mol]
    1.5,      # C  — supersaturation order
    0.5       # D  — moment order
])

# ── 4. GROWTH  [3 elements: A, B, C] ───────────────────────────────────────
# f = A * exp(-B / (R*T)) * σ|σ|^(C-1)
# Result units: μm/s  (crystal linear growth rate)
#   A : pre-exponential [μm/s]
#   B : activation energy [J/mol]
#   C : supersaturation order
growth_params = np.array([
    5.0e3,    # A  [μm/s]
    4.5e4,    # B  [J/mol]
    1.5       # C
])

# ── 5. (OPTIONAL) DISSOLUTION  [3 elements: A, B, C] ──────────────────────
# Same form as growth but applies when σ < 0 (undersaturation)
dissol_params = np.array([
    5.0e3,
    4.5e4,
    1.5
])

# ── Assemble ────────────────────────────────────────────────────────────────
sim.CR01.Kinetics = CrystKinetics(
    coeff_solub  = solub_cts,
    nucl_prim    = prim_params,
    nucl_sec     = sec_params,
    growth       = growth_params,
    dissolution  = dissol_params,   # omit if no dissolution expected
    sup_sat_type = 'relative'       # σ = (c - c*)/c*  — default
)
